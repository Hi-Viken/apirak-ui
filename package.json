{
  "name": "apirak",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:test": "vite --host 127.0.0.1 --mode test",
    "dev:prod": "vite --host 127.0.0.1 --mode production",
    "dev:local": "vite --host 127.0.0.1 --mode local",
    "build": "vue-tsc --noEmit && vite build",
    "build:test": "vue-tsc --noEmit && vite build --mode test",
    "build:prod": "vue-tsc --noEmit && vite build --mode production",
    "build:dotnet": "vue-tsc --noEmit && (if exist dist rmdir /s /q dist) && vite build --mode dotnet",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vueuse/core": "^12.5.0",
    "dompurify": "^3.4.13",
    "js-yaml": "^4.1.0",
    "jsonpath-plus": "^10.3.0",
    "lucide-vue-next": "^0.468.0",
    "marked": "^15.0.0",
    "monaco-editor": "^0.52.2",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.7"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.23.0",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
